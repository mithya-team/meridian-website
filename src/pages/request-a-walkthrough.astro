---
import Base from "../layouts/Base.astro";
import "../styles/site.css";
import "../styles/walkthrough.css";

// Where the form sends its answers. Empty until the team connects it: then the page says plainly
// that nothing was sent. Set it to the form service's address (it receives a POST of the fields below).
const FORM_ENDPOINT = "";
---
<Base
  title="Request a walkthrough · Meridian"
  description="See one MDF request go end to end in Meridian, with your activity types and your approval rules."
  share="og-home.png"
  shareAlt="Meridian: The whole MDF cycle, on one common process."
>

<main id="main">

<section class="wt" id="top"><div class="in wt-grid">

  <div class="wt-copy">
    <span class="pill">Request a walkthrough</span>
    <h1>See one request <em>go end to end.</em></h1>
    <p class="lead">We'll walk one MDF request from first draft to paid claim, with your activity types and your approval rules.</p>
    <ul class="wt-expect">
      <li><i class="ok">✓</i><span><b>One call</b>, at a time that suits you.</span></li>
      <li><i class="ok">✓</i><span><b>Your process, not a script.</b> Tell us your activity types and who approves what, and we'll set them up for the call.</span></li>
      <li><i class="ok">✓</i><span><b>Bring finance, audit and security.</b> We'll answer their questions on the record itself.</span></li>
    </ul>
    <p class="wt-alt">Questions first? <a class="lk" href="/questions">Read the answers <span aria-hidden="true">→</span></a></p>
  </div>

  <div class="wt-card card">
    <form id="wtForm" class="wt-form" data-endpoint={FORM_ENDPOINT} method="post" novalidate>
      <h2 class="wt-h">Tell us a little about you</h2>
      <p class="wt-req">Fields marked <span aria-hidden="true">*</span><span class="sr">with an asterisk</span> are required.</p>

      <div class="wt-row">
        <label class="wt-f" for="wt-name"><span>Full name <i aria-hidden="true">*</i></span>
          <input id="wt-name" name="name" type="text" autocomplete="name" required>
        </label>
        <label class="wt-f" for="wt-email"><span>Work email <i aria-hidden="true">*</i></span>
          <input id="wt-email" name="email" type="email" autocomplete="email" inputmode="email" required>
        </label>
      </div>

      <div class="wt-row">
        <label class="wt-f" for="wt-company"><span>Company <i aria-hidden="true">*</i></span>
          <input id="wt-company" name="company" type="text" autocomplete="organization" required>
        </label>
        <label class="wt-f" for="wt-title"><span>Job title</span>
          <input id="wt-title" name="job_title" type="text" autocomplete="organization-title">
        </label>
      </div>

      <div class="wt-row">
        <label class="wt-f" for="wt-team"><span>Your team <i aria-hidden="true">*</i></span>
          <select id="wt-team" name="team" required>
            <option value="" selected disabled>Choose one</option>
            <option>Channel or partner marketing</option>
            <option>Finance</option>
            <option>Procurement</option>
            <option>Internal audit</option>
            <option>IT or security</option>
            <option>Other</option>
          </select>
        </label>
        <label class="wt-f" for="wt-partners"><span>Number of partners</span>
          <select id="wt-partners" name="partner_count">
            <option value="" selected>Choose one</option>
            <option>Fewer than 50</option>
            <option>50 to 249</option>
            <option>250 to 999</option>
            <option>1,000 or more</option>
            <option>Not sure</option>
          </select>
        </label>
      </div>

      <fieldset class="wt-f wt-set">
        <legend>Regions you run MDF in</legend>
        <div class="wt-opts">
          <label><input type="checkbox" name="regions" value="North America"><span>North America</span></label>
          <label><input type="checkbox" name="regions" value="Latin America"><span>Latin America</span></label>
          <label><input type="checkbox" name="regions" value="Europe"><span>Europe</span></label>
          <label><input type="checkbox" name="regions" value="Middle East and Africa"><span>Middle East and Africa</span></label>
          <label><input type="checkbox" name="regions" value="Asia Pacific"><span>Asia Pacific</span></label>
        </div>
      </fieldset>

      <label class="wt-f" for="wt-notes"><span>What would you like to see?</span>
        <textarea id="wt-notes" name="notes" rows="4" maxlength="2000" placeholder="For example: how claims are checked before payment, or how approvals work across regions."></textarea>
      </label>

      <!-- Leave empty: a trap for automated sign-ups. Hidden from people and screen readers. -->
      <div class="wt-trap" aria-hidden="true"><label for="wt-website">Website</label><input id="wt-website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
      <input type="hidden" name="source" id="wt-source">

      <label class="wt-consent" for="wt-consent">
        <input id="wt-consent" name="consent" type="checkbox" value="yes" required>
        <span>I agree that Meridian may contact me about this request. <a href="/privacy">How we use your details</a> <i aria-hidden="true">*</i></span>
      </label>

      <p class="wt-err" id="wtErr" role="alert" hidden></p>
      <button class="btn wt-send" type="submit">Request a walkthrough</button>
    </form>

    <div class="wt-done" id="wtDone" tabindex="-1" hidden>
      <i class="ok big">✓</i>
      <h2 class="wt-h">Thanks<span id="wtWho"></span>.</h2>
      <p>We'll be in touch to find a time. If you told us your activity types, we'll set them up before the call.</p>
      <a class="lk" href="/how-it-works">Meanwhile, see how it works <span aria-hidden="true">→</span></a>
    </div>

    <div class="wt-off" id="wtOff" tabindex="-1" hidden>
      <h2 class="wt-h">This form isn't connected yet</h2>
      <p>Your answers were checked but <b>not sent</b>. The team connects this form before the site launches.</p>
      <button class="btn ghost sm" type="button" id="wtBack">Back to the form</button>
    </div>
  </div>

</div></section>

</main>

<script>
  import "../scripts/walkthrough.js";
</script>
</Base>
