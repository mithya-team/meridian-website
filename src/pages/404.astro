---
import Base from "../layouts/Base.astro";
import "../styles/site.css";
---
<Base
  title="Page not found · Meridian"
  description="This page isn't on the Meridian website."
  share="og-home.png"
  shareAlt="Meridian: The whole MDF cycle, on one common process."
>
<main id="main">
<section class="hero nf" id="top"><div class="in hero-grid">
  <div class="hero-copy">
    <span class="pill">Page not found</span>
    <h1>This page <em>isn't here.</em></h1>
    <p class="lead">The address may be mistyped, or the page may have moved. Everything about Meridian starts from the homepage.</p>
    <div class="btns"><a class="btn" href="/">Go to the homepage</a><a class="btn ghost" href="/how-it-works">See how it works</a></div>
  </div>
</div></section>
</main>
</Base>
