  <div class="ac-well" aria-hidden="true">
    <div class="ac-pdf">
      <div class="ac-pdf-h"><small>Orbinex Software | Partner Marketing</small><b>Marketing Development Funds (MDF) Request Form FY27</b><small>Request MDF-000033 · Activity ACT-000007</small></div>
      <p class="ac-pdf-s">1&nbsp;&nbsp;Partner &amp; Contact Information</p>
      <dl>
        <div><dt>Country <i>*</i></dt><dd>Germany</dd></div>
        <div><dt>Partner / Company name <i>*</i></dt><dd>Brightfold Solutions</dd></div>
        <div><dt>Partner tier / type <i>*</i></dt><dd>Reseller</dd></div>
